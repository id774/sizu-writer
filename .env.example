# Copy this file to .env and adjust the values.
# Keep the file readable by the service user only (chmod 600).
#
# The four required settings have no defaults. sizu-writer refuses to
# start without them rather than picking an endpoint for you: a request
# that leaves for a service nobody named is worse than one that never
# leaves. Nothing here is specific to OpenAI; the openai package is the
# client, and which service answers is decided by GENERATION_BASE_URL.
#
# The example below is Sakura AI Engine. Other worked examples are in
# README.md under "Choosing an endpoint".

# Wire protocol of the endpoint. Required.
# 'openai-compatible' is the only value this version accepts.
GENERATION_BACKEND=openai-compatible

# API key or Bearer token of the endpoint. Required.
# Left empty on purpose: a placeholder here reads as a configured token,
# so the failure would only appear on the API call instead of at setup.
# Sakura AI Engine issues an account token shaped '<UUID>:<secret>' in
# the control panel; paste the whole string, colon included.
GENERATION_API_TOKEN=

# Base URL of the endpoint. Required, https only.
# Include the version path and stop there: the SDK appends
# /chat/completions itself, and a URL that already carries it is
# refused at startup.
#   Sakura AI Engine  https://api.ai.sakura.ad.jp/v1
#   OpenAI            https://api.openai.com/v1
GENERATION_BASE_URL=https://api.ai.sakura.ad.jp/v1

# Model used for generation. Required; no default is shipped, because
# the available models differ per endpoint and change over time. Read
# the name off the endpoint's own list of available models. On the
# Sakura AI Engine free plan for foundational models, pick one the free
# allowance covers: the closed models are outside it.
GENERATION_MODEL=preview/Kimi-K2.6

# How a structured answer is asked for.
#   prompt-json  send no response_format; the prompt carries the
#                contract. Works with an endpoint or a model that
#                rejects the parameter.
#   json-object  send response_format={"type":"json_object"} as well.
# There is no automatic choice: trying one and retrying with the other
# would turn one generation into two requests.
GENERATION_RESPONSE_MODE=prompt-json

# Seconds allowed for one request. The answer is not streamed, so this
# is the whole generation: a post of a few paragraphs plus its titles,
# written by a model on a shared endpoint. 60 was too tight for that and
# timed out on memos of a single line, where nothing the writer can do
# to the memo makes the answer arrive sooner. Raising it means raising
# the gunicorn --timeout (240) and the Apache ProxyTimeout (300) too.
GENERATION_TIMEOUT=120

# Retries left to the SDK. 0 means one screen action or one CLI run
# spends one request, which is what a plan counting requests needs.
# Raising it multiplies the worst case wait by the same factor.
GENERATION_MAX_RETRIES=0

# Sent only when set, so that a model refusing the parameter still runs.
GENERATION_TEMPERATURE=

# Upper bound of one response.
MAX_OUTPUT_TOKENS=6000

# Upper bound of the input field.
MAX_INPUT_CHARS=4000

# Number of alternative titles kept.
MAX_ALT_TITLES=4

# Directory holding the prompt files.
PROMPT_DIR=prompts

# Level of the application log.
LOG_LEVEL=INFO

# Port of the development server and of gunicorn.
PORT=8090

# The legacy OPENAI_* settings are not read. A process finding one of
# them in its environment stops at startup and names its replacement,
# so that a stale export cannot decide where a memo is sent.
