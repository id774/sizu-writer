# Copy this file to .env and adjust the values.
# Keep the file readable by the service user only (chmod 600).

# API key of the OpenAI compatible endpoint. Left empty on purpose: a
# placeholder here reads as a configured key, so the failure would only
# appear on the API call instead of at setup time.
OPENAI_API_KEY=

# Base URL of an OpenAI compatible endpoint. Leave empty for OpenAI.
OPENAI_BASE_URL=

# Model used for generation. No default is shipped, because a sensible
# one differs per endpoint.
OPENAI_MODEL=

# Seconds allowed for one request. Raising it means raising the gunicorn
# --timeout (120) and the Apache ProxyTimeout (180) as well.
OPENAI_TIMEOUT=60

# Retries left to the SDK. Set 0 to spend exactly one request.
OPENAI_MAX_RETRIES=2

# Sent only when set, so that a model refusing the parameter still runs.
OPENAI_TEMPERATURE=

# Upper bound of one response.
MAX_OUTPUT_TOKENS=6000

# Upper bound of the input field.
MAX_INPUT_CHARS=4000

# Number of alternative titles kept.
MAX_ALT_TITLES=4

# Directory holding the prompt files.
PROMPT_DIR=prompts

# Level of the application log.
LOG_LEVEL=INFO

# Port of the development server and of gunicorn.
PORT=8090
